---
interface Props {
  readonly class: string;
  readonly arc: string;
  readonly side: 'back' | 'front';
}

const { class: className, arc, side } = Astro.props;
---

<svg class={className} viewBox="-600 -600 1200 1200" fill="none" focusable="false">
  <g transform="rotate(-18)">
    <path class="earth__orbit-line" pathLength="1" d={arc}></path>
    <g
      class="earth__satellite"
      data-orbit-side={side}
      transform="translate(280 130) rotate(-28)"
      visibility={side === 'front' ? 'visible' : 'hidden'}
    >
      <line class="earth__satellite-mast" x1="0" y1="-5" x2="0" y2="-12"></line>
      <rect class="earth__satellite-panel" x="-20" y="-4" width="13" height="8" rx="1"></rect>
      <rect class="earth__satellite-panel" x="7" y="-4" width="13" height="8" rx="1"></rect>
      <rect class="earth__satellite-body" x="-6" y="-6" width="12" height="12" rx="2"></rect>
    </g>
  </g>
</svg>
