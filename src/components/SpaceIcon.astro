---
import type { SpaceIconName } from '../data/types';

interface Props {
  readonly name: SpaceIconName;
}

const { name } = Astro.props;
---

<svg
  class="space-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'dish' && (
      <>
        <path d="M5 8a9 9 0 0 0 11 11z" />
        <path d="M10.5 13.5 15 9" />
        <circle cx="16" cy="8" r="1.5" />
        <path d="M18 3a3 3 0 0 1 3 3" />
        <path d="M9 18l-2 3h6" />
      </>
    )
  }
  {
    name === 'shield' && (
      <>
        <path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z" />
        <path d="M2 14c4 1.5 16-.5 20-5" />
      </>
    )
  }
  {
    name === 'telescope' && (
      <>
        <path d="M3 12l14-7 2 4-14 7z" />
        <path d="M11 13l3 8" />
        <path d="M9.5 14l-3 7" />
        <path d="M20 15v3" />
        <path d="M18.5 16.5h3" />
      </>
    )
  }
  {
    name === 'cargo' && (
      <>
        <rect x="4" y="8" width="16" height="12" rx="1" />
        <path d="M4 12h16" />
        <path d="M9 8V5h6v3" />
        <path d="M12 12v8" />
      </>
    )
  }
  {
    name === 'relay' && (
      <>
        <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
        <path d="M4 14h3v5H4z" />
        <path d="M17 14h3v5h-3z" />
        <path d="M20 19a4 4 0 0 1-4 3h-3" />
      </>
    )
  }
  {
    name === 'habitat' && (
      <>
        <path d="M3 19a9 9 0 0 1 18 0z" />
        <circle cx="9" cy="15.5" r="1.4" />
        <circle cx="15" cy="15.5" r="1.4" />
        <path d="M12 10V4" />
        <path d="M12 4l3.5 1.5L12 7" />
      </>
    )
  }
  {
    name === 'beacon' && (
      <>
        <path d="M12 9v12" />
        <path d="M8 21h8" />
        <circle cx="12" cy="7" r="2" />
        <path d="M7 3.5a7 7 0 0 0 0 7" />
        <path d="M17 3.5a7 7 0 0 1 0 7" />
      </>
    )
  }
  {
    name === 'comet' && (
      <>
        <circle cx="8" cy="16" r="4" />
        <path d="M11 13l9-9" />
        <path d="M12 17l7-5" />
        <path d="M7 12l5-7" />
      </>
    )
  }
  {name === 'waves' && <path d="M3 12h2l2-6 3 14 3-10 2 5 2-3h4" />}
  {
    name === 'observatory' && (
      <>
        <path d="M4 15a8 8 0 0 1 16 0z" />
        <path d="M11 7.2 10 15" />
        <path d="M3 15h18v6H3z" />
        <path d="M12 18h.01" />
      </>
    )
  }
  {
    name === 'language' && (
      <>
        <path d="M9 8l-4 4 4 4" />
        <path d="M15 8l4 4-4 4" />
        <path d="M13 6l-2 12" />
      </>
    )
  }
  {
    name === 'data' && (
      <>
        <ellipse cx="12" cy="6" rx="7" ry="3" />
        <path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6" />
        <path d="M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3" />
      </>
    )
  }
  {
    name === 'stream' && (
      <>
        <path d="M3 8c4-4 6 4 10 0s6-2 8 0" />
        <path d="M3 16c4-4 6 4 10 0s6-2 8 0" />
      </>
    )
  }
  {name === 'cloud' && <path d="M7 18a4 4 0 0 1-.6-8A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9z" />}
  {
    name === 'radar' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="4" />
        <path d="M12 12l6-6" />
      </>
    )
  }
  {
    name === 'probe' && (
      <>
        <path d="M21 12a9 9 0 1 1-4-7.5" />
        <path d="M8 12l3 3 9-9" />
      </>
    )
  }
  {
    name === 'pipeline' && (
      <>
        <circle cx="5" cy="6" r="2" />
        <circle cx="19" cy="18" r="2" />
        <path d="M7 6h6a4 4 0 0 1 4 4v6" />
        <path d="M5 8v7a3 3 0 0 0 3 3h9" />
      </>
    )
  }
  {
    name === 'window' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 9h18" />
        <path d="M7 7h.01" />
      </>
    )
  }
</svg>
