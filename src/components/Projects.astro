---
import '../styles/components/sections.css';
import '../styles/components/timeline.css';
import { GITHUB_URL } from '../data/links';
import { PROJECTS } from '../data/projects';
import type { Dictionary } from '../i18n/types';

interface Props {
  readonly dict: Dictionary;
}

const { dict } = Astro.props;
const copy = dict.projects;
---

<section class="section" id="projetos" aria-labelledby="projects-title">
  <header class="section__header">
    <h2 class="section__title" id="projects-title">{copy.title}</h2>
    <p class="section__intro">{copy.intro}</p>
  </header>
  <ul class="project-list">
    {
      PROJECTS.map((project) => {
        const item = copy.items[project.id];
        return (
          <li>
            <a
              class:list={['panel', 'project', { 'project--featured': project.featured }]}
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              data-spotlight
            >
              {item.eyebrow && <p class="project__eyebrow">{item.eyebrow}</p>}
              <h3 class="project__name">{item.name}</h3>
              <p class="project__summary">{item.summary}</p>
              {project.tools && (
                <div class="project__group">
                  <p class="project__label">{copy.toolsLabel}</p>
                  <ul class="timeline__tags project__tools">
                    {project.tools.map((tool) => <li>{tool}</li>)}
                  </ul>
                </div>
              )}
              <div class="project__group">
                {project.featured && <p class="project__label">{copy.stackLabel}</p>}
                <ul class="timeline__tags">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              {item.learnings && (
                <div class="project__group">
                  <p class="project__label">{copy.learningsLabel}</p>
                  <ul class="project__learnings">
                    {item.learnings.map((learning) => <li>{learning}</li>)}
                  </ul>
                </div>
              )}
              {item.ctaLabel && (
                <span class="project__cta" data-magnetic>
                  {item.ctaLabel} <span aria-hidden="true">↗</span>
                </span>
              )}
              <span class="sr-only">({dict.newTabHint})</span>
            </a>
          </li>
        );
      })
    }
  </ul>
  <p class="section__note">
    <a class="text-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
      {copy.allLabel} →<span class="sr-only"> ({dict.newTabHint})</span>
    </a>
  </p>
</section>
