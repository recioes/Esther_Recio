---
import '../styles/components/timeline.css';
import { TECH_ICONS, TIMELINE } from '../data/timeline';
import type { Dictionary } from '../i18n/types';
import { formatPeriod } from '../lib/period';
import SpaceIcon from './SpaceIcon.astro';

interface Props {
  readonly dict: Dictionary;
}

const { dict } = Astro.props;
const copy = dict.timeline;
---

<section class="timeline" id="trajetoria" aria-labelledby="timeline-title">
  <header class="timeline__header">
    <h2 class="timeline__title" id="timeline-title">{copy.title}</h2>
    <p class="timeline__intro">{copy.intro}</p>
    <p class="timeline__legend" aria-hidden="true">
      <span class="timeline__legend-item" data-kind="work">{copy.kindLabels.work}</span>
      <span class="timeline__legend-item" data-kind="education">{copy.kindLabels.education}</span>
    </p>
  </header>
  <ol class="timeline__list">
    {
      TIMELINE.map((entry, index) => {
        const item = copy.items[entry.id];
        return (
          <li
            class="timeline__item"
            data-kind={entry.kind}
            data-tone={index % 4}
            data-current={entry.current ? '' : undefined}
            data-timeline-item
            data-no-drag
          >
            <span class="timeline__dot" aria-hidden="true">
              <SpaceIcon name={entry.icon} />
            </span>
            <article class="timeline__card" data-spotlight>
              <span class="timeline__stage" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="timeline__period">
                <span class="sr-only">{copy.kindLabels[entry.kind]}: </span>
                {formatPeriod(entry.start, entry.end, dict.htmlLang, copy.present)}
                {entry.current && <span class="timeline__now">{copy.currentLabel}</span>}
              </p>
              <h3 class="timeline__role">{item.title}</h3>
              <p class="timeline__org">{item.org}</p>
              {item.highlight && <p class="timeline__highlight">{item.highlight}</p>}
              <p class="timeline__summary">{item.summary}</p>
              {
                item.points && (
                  <ul class="bullets">
                    {item.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )
              }
              {
                entry.tags && (
                  <ul class="timeline__tags">
                    {entry.tags.map((tag) => {
                      const icon = TECH_ICONS[tag];
                      return (
                        <li>
                          {icon && <SpaceIcon name={icon} />}
                          {tag}
                        </li>
                      );
                    })}
                  </ul>
                )
              }
            </article>
          </li>
        );
      })
    }
  </ol>
</section>
