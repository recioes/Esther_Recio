---
import '../styles/components/hero.css';
import '../styles/components/sparkles.css';

interface Props {
  readonly name: string;
  readonly initials: string;
  readonly role: string;
  readonly coordinates: string;
  readonly lead: string;
}

const { name, initials, role, coordinates, lead } = Astro.props;
---

<header class="hero reveal" data-reveal="1">
  <div class="hero__monogram" aria-hidden="true" data-no-tap>
    <span>{initials}</span>
  </div>
  <p class="hero__coords">{coordinates}</p>
  <div class="hero__name-wrap" data-sparkle data-no-tap>
    <h1 class="hero__name">{name}</h1>
    <span class="sparkle-layer" data-sparkle-layer aria-hidden="true"></span>
  </div>
  <p class="hero__role">{role}</p>
  <p class="hero__lead">{lead}</p>
</header>
