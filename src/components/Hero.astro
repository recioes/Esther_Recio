---
import '../styles/components/hero.css';
import '../styles/components/sparkles.css';

interface Props {
  readonly name: string;
  readonly initials: string;
  readonly role: string;
}

const { name, initials, role } = Astro.props;
---

<header class="hero reveal" data-reveal="1">
  <div class="hero__monogram" aria-hidden="true">
    <span>{initials}</span>
  </div>
  <div class="hero__name-wrap" data-sparkle>
    <h1 class="hero__name">{name}</h1>
    <span class="sparkle-layer" data-sparkle-layer aria-hidden="true"></span>
  </div>
  <p class="hero__role">{role}</p>
</header>
